# Server secrets go into Render environment/secrets, never Git or client files.
SPRING_PROFILES_ACTIVE=production
PORT=8081
# Copy the exact host from Supabase > Connect > Session pooler (port 5432).
# Do not include username:password@ or user=postgres in this URL.
DB_URL=jdbc:postgresql://YOUR-SESSION-POOLER:5432/postgres?sslmode=require&connectTimeout=10&socketTimeout=30&tcpKeepAlive=true
# The project suffix is required by the shared pooler; plain postgres causes ENOIDENTIFIER.
# Older deployed revisions read DB_USER; set it to the SAME value when fixing those revisions.
DB_USERNAME=postgres.YOUR_PROJECT_REF
# Raw database password, not a Supabase API key and not URL-encoded here.
DB_PASSWORD=REPLACE_PRIVATELY
DB_POOL_MAX=3
JWT_SECRET=GENERATE_AT_LEAST_48_RANDOM_BYTES_BASE64
JWT_EXPIRATION_MS=86400000
APP_PUBLIC_URL=https://YOUR-APP.pages.dev
API_PUBLIC_URL=https://YOUR-API.onrender.com
CORS_ORIGINS=https://YOUR-APP.pages.dev,chrome-extension://bafnmcdkpidnpollodebmifggmmpkbje
APP_TIMEZONE=Asia/Kolkata
# Review trusted Render ingress addresses before enabling proxy-derived rate keys.
TRUSTED_PROXY_CIDRS=
FLYWAY_ENABLED=false
API_DOCS_ENABLED=false
RECOVERY_ENABLED=true
MAIL_PROVIDER=brevo
BREVO_API_KEY=REPLACE_PRIVATELY
MAIL_FROM=YOUR_VERIFIED_SENDER_EMAIL
MAIL_DAILY_LIMIT=250
NOTIFICATIONS_ENABLED=true
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
REMINDER_TRIGGER_SECRET=GENERATE_A_DIFFERENT_48_RANDOM_BYTE_BASE64_SECRET
# Maintenance command only; never set these in normal Render runtime:
# EXPECTED_DATABASE=postgres
# EXPECTED_DATABASE_ROLE=postgres
# BACKUP_VERIFIED=true
# MIGRATION_APPROVED=true
# LEGACY_V4_REVIEWED=true
